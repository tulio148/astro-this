---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import costumeHireHeroImage from "../images/costumeHireHeroAvif.avif";
import { serviceSchema } from "../lib/schema";

const title = "Group Costume Hire Perth | Performance & Ensemble Costume Sets";
const description = "Group costume hire in Perth for troupe performances, ensemble photoshoots, themed corporate events, and cohesive Carnival styling.";
const url = "/group-costume-hire-perth";
const structuredData = [serviceSchema({ name: "Group costume hire in Perth", description, url, image: costumeHireHeroImage.src })];
---

<Layout title={title} description={description} image={costumeHireHeroImage.src} url={url} structuredData={structuredData}>
    <TextHeroTop
    pageTitle="Group Costume Hire in Perth"
    pageSubtitle="Matching sets and complementary colour combinations for performers, groups, productions, and themed events."
    valueTitle="Coordinate the whole group"
    valueSubtitle="Group hire is planned around fit, colour, logistics, and return flow."
    paragraphs={[
      "Group costume hire is scoped to keep visual cohesion across multiple performers while staying practical for movement.",
      "Planning includes sizing, matching pieces, hire duration, deposits, and pickup/return coordination."
    ]}
    chips={["Matching sets", "Group sizing", "Event logistics"]}
  />
    <TextHeroTop
    pageTitle="Group Costume Hire in Perth"
    pageSubtitle="Matching sets and complementary colour combinations for performers, groups, productions, and themed events."
    valueTitle="Coordinate the whole group"
    valueSubtitle="Group hire is planned around fit, colour, logistics, and return flow."
    paragraphs={[
      "Group costume hire is scoped to keep visual cohesion across multiple performers while staying practical for movement.",
      "Planning includes sizing, matching pieces, hire duration, deposits, and pickup/return coordination."
    ]}
    chips={["Matching sets", "Group sizing", "Event logistics"]}
  />
  <SectionContainer spacing="footer-offset" id="group-costume-enquiry"><ContactForm title="Group Costume Hire Enquiry" subtitle="Include group size, size range, event date, colour direction, and whether you need matching or complementary pieces." subject="Group Costume Hire Enquiry" /></SectionContainer>
</Layout>
