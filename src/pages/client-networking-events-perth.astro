---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import FAQItem from "../components/FAQItem.astro";
import ContactForm from "../components/ContactForm.astro";
import showForHireHero from "../images/showhero.avif";
import { faqSchema, serviceSchema } from "../lib/schema";

const title = "Networking Event Entertainment Perth | Roving Samba for Corporate Functions";
const description = "Roving samba performers for client dinners, cocktail parties, networking events, and corporate relationship functions in Perth.";
const url = "/client-networking-events-perth";
const faqs = [
  { question: "How much space do roving performers need?", answer: "Roving performers work through normal event circulation paths and do not require a stage." },
  { question: "How long does a roving set run?", answer: "Set length and breaks are scoped to the event, venue, and number of performers." },
  { question: "Can performers interact with guests?", answer: "Yes. Interaction is warm and approachable, not intrusive, and can be adjusted to the tone of the event." },
];
const structuredData = [serviceSchema({ name: "Client networking event entertainment in Perth", description, url, image: showForHireHero.src }), faqSchema(faqs)];
---

<Layout title={title} description={description} image={showForHireHero.src} url={url} structuredData={structuredData}>
    <TextHeroTop
    pageTitle="Entertainment for Client Events and Networking Functions"
    pageSubtitle="Roving performers that bring energy to your cocktail hour without interrupting the conversations that matter."
    valueTitle="Ambient energy, not a program interruption"
    valueSubtitle="Networking entertainment should lift atmosphere while letting guests keep talking."
    paragraphs={[
      "Roving samba performers create natural conversation starters, photo moments, and energy across arrivals or cocktail hour.",
      "The format is designed for movement through the room rather than a seated audience, so it feels integrated instead of disruptive."
    ]}
    chips={["Roving format", "Conversation-friendly", "Corporate networking"]}
  />
    <TextHeroTop
    pageTitle="Entertainment for Client Events and Networking Functions"
    pageSubtitle="Roving performers that bring energy to your cocktail hour without interrupting the conversations that matter."
    valueTitle="Ambient energy, not a program interruption"
    valueSubtitle="Networking entertainment should lift atmosphere while letting guests keep talking."
    paragraphs={[
      "Roving samba performers create natural conversation starters, photo moments, and energy across arrivals or cocktail hour.",
      "The format is designed for movement through the room rather than a seated audience, so it feels integrated instead of disruptive."
    ]}
    chips={["Roving format", "Conversation-friendly", "Corporate networking"]}
  />
  <SectionContainer><SectionTitle title="Venue types" class="section-intro" /><div class="grid grid-cols-2 gap-3 md:grid-cols-4">{["Restaurant private dining", "Hotel pre-function", "Rooftop events", "Private clubs"].map((item)=><div class="rounded-full border border-db-pink/30 bg-white px-5 py-3 text-center font-black text-db-pink">{item}</div>)}</div></SectionContainer>
  <SectionContainer><SectionTitle title="Networking FAQs" class="section-intro" /><div class="mx-auto max-w-5xl">{faqs.map((faq)=><FAQItem question={faq.question} answer={faq.answer} />)}</div></SectionContainer>
  <SectionContainer spacing="footer-offset" id="networking-enquiry"><ContactForm title="Client or Networking Event Enquiry" subtitle="Include your venue, guest numbers, event flow, and whether you want roving only or a short feature moment." subject="Client or Networking Event Enquiry" /></SectionContainer>
</Layout>
