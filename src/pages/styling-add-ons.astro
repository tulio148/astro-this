---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ContactForm from "../components/ContactForm.astro";
import costumeHireHeroImage from "../images/costumeHireHeroAvif.avif";
import { serviceSchema } from "../lib/schema";

const title = "Styling Add-ons | Hair, Makeup & Costume Styling";
const description = "Optional styling, hair, makeup, and costume guidance add-ons for Dance Bloc Brazil costume hire, photoshoots, workshops, and event bookings.";
const url = "/styling-add-ons";
const structuredData = [serviceSchema({ name: "Costume styling add-ons in Perth", description, url, image: costumeHireHeroImage.src })];
---

<Layout title={title} description={description} image={costumeHireHeroImage.src} url={url} structuredData={structuredData}>
  <SectionContainer>
    <SectionTitle title="Styling Add-ons" subtitle="Hair, makeup, and costume styling support available as optional add-ons to costume hire, photoshoots, workshops, or event bookings." class="section-intro" />
    <SectionTitle title="What can be added" subtitle="Styling support is quoted separately and depends on availability, timing, location, and whether partner referrals are required." class="section-intro" />
<div class="grid grid-cols-1 gap-5 md:grid-cols-3">{["Costume styling guidance", "Hair and makeup by enquiry", "Partner referrals when outsourced"].map((item)=><div class="rounded-xl border border-db-pink/80 bg-white p-7 text-xl font-black text-db-pink">{item}</div>)}</div></SectionContainer>
  <SectionContainer tone="tint"><SectionTitle title="Book alongside costume hire" subtitle="Mention styling in your costume hire or photoshoot enquiry so timing, access, and quote details can be coordinated." /></SectionContainer>
  <SectionContainer spacing="footer-offset" id="styling-enquiry"><ContactForm title="Styling Add-ons Enquiry" subtitle="Include your booking type, date, location, styling needs, and whether you already have hair or makeup booked." subject="Styling Add-ons Enquiry" /></SectionContainer>
</Layout>
