---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ComingSoonNotice from "../components/ComingSoonNotice.astro";
import classesHero from "../images/classesHero.webp";
import { organizationSchema } from "../lib/schema";

const title = "Community | Dance Bloc Brazil Classes & Workshops";
const description =
  "The community around Dance Bloc Brazil classes, workshops, events, and public samba experiences in Perth.";
const url = "/community";
---

<Layout
  title={title}
  description={description}
  image={classesHero.src}
  url={url}
  structuredData={[organizationSchema()]}
>
  <TextHeroTop
    pageTitle="Dance Bloc Brazil Community"
    pageSubtitle="The class and workshop community behind the performances, public events, and samba energy."
    valueTitle="Who attends"
    valueSubtitle="Adults of different ages, dance backgrounds, fitness levels, and confidence levels come together through samba."
    paragraphs={[
      "The community includes first-time students, returning dancers, and people joining for movement, rhythm, and social connection.",
      "Everyone can engage at their own pace while staying connected to regular classes, workshops, and events."
    ]}
    chips={["First-time students", "Returning dancers", "Community groups"]}
  />

  <SectionContainer tone="tint">
    <SectionTitle
      title="Class to performance pathway"
      subtitle="A clearer pathway is being prepared for students who want to understand how classes, workshops, and performance opportunities connect."
      class="section-intro"
    />
    <ComingSoonNotice
      title="Pathway details"
      message="This section will outline the class-to-community journey once current class terms, workshop options, and performance pathways are confirmed."
      items={[
        "Class progression",
        "Workshop opportunities",
        "Community event updates",
        "Performance readiness",
      ]}
    />
  </SectionContainer>

  <SectionContainer>
    <SectionTitle
      title="Stay connected"
      subtitle="Follow social channels for class terms, community events, public performances, and new workshop dates."
    />
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/samba-classes-perth"
        class="rounded-full bg-db-green px-7 py-3 text-sm font-black uppercase tracking-[0.14em] text-white hover:bg-db-pink"
      >
        Classes
      </a>
      <a
        href="/private-samba-workshops-perth"
        class="rounded-full border border-db-pink/80 bg-white px-7 py-3 text-sm font-black uppercase tracking-[0.14em] text-db-pink hover:bg-db-pink hover:text-white"
      >
        Workshops
      </a>
    </div>
  </SectionContainer>
</Layout>
