---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import danceclassHero from "../images/danceclassHero.avif";
import { serviceSchema } from "../lib/schema";

const title = "School Workshops Perth | Brazilian Culture & Samba Programs";
const description = "Age-appropriate Brazilian samba and culture workshops for Perth schools, universities, youth programs, and student events.";
const url = "/school-workshops-perth";
const structuredData = [serviceSchema({ name: "School samba workshops in Perth", description, url, image: danceclassHero.src })];
const outcomes = ["Rhythm and coordination", "Cultural awareness", "Confidence through movement", "Connection to Brazilian music and geography"];
---

<Layout title={title} description={description} image={danceclassHero.src} url={url} structuredData={structuredData}>
    <TextHeroTop
    pageTitle="Brazilian Samba Workshops for Schools"
    pageSubtitle="Age-appropriate cultural dance programs for primary, secondary, tertiary, and youth groups."
    valueTitle="Movement, rhythm, and cultural context"
    valueSubtitle="Workshops connect movement with Brazilian music, geography, and culture."
    paragraphs={[
      "Sessions can be adjusted by age and confidence level to fit school timetables, assemblies, and special programs.",
      "A typical 45-60 minute structure balances participation, learning outcomes, and practical class delivery."
    ]}
    chips={["Age-appropriate", "45-60 minute formats", "Cultural learning"]}
  />
  <SectionContainer tone="tint"><SectionTitle title="What students take away" class="section-intro" /><div class="grid grid-cols-1 gap-5 md:grid-cols-4">{outcomes.map((item)=><div class="rounded-xl border border-db-pink/80 bg-white p-6 text-lg font-black text-db-pink">{item}</div>)}</div></SectionContainer>
  <SectionContainer tone="dark-band"><SectionTitle title="Booking and safety details" subtitle="Share year level, group size, timetable block, available space, and any safety or child-safe documentation requirements." class="section-intro [&_h2]:text-white [&_p]:text-white/70" /></SectionContainer>
  <SectionContainer spacing="footer-offset" id="school-enquiry"><ContactForm title="School Workshop Enquiry" subtitle="Include school name, year level, group size, preferred dates, available space, and program goals." subject="School Workshop Enquiry" /></SectionContainer>
</Layout>
