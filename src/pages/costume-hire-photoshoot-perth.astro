---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import costumeHireHeroImage from "../images/costumeHireHeroAvif.avif";
import { serviceSchema } from "../lib/schema";

const title = "Costume Hire Photoshoot Perth | Brazilian Carnival Styling";
const description =
  "Brazilian samba and Carnival costume hire for Perth photoshoots, content creation, editorials, and personal campaigns.";
const url = "/costume-hire-photoshoot-perth";
const structuredData = [
  serviceSchema({
    name: "Photoshoot costume hire in Perth",
    description,
    url,
    image: costumeHireHeroImage.src,
  }),
];
---

<Layout
  title={title}
  description={description}
  image={costumeHireHeroImage.src}
  url={url}
  structuredData={structuredData}
>
  <TextHeroTop
    pageTitle="Costume Hire for Photoshoots"
    pageSubtitle="Brazilian Carnival styling for photographers, creators, brands, editorials, and personal campaigns."
    valueTitle="Visual impact built for camera"
    valueSubtitle="Pieces selected for colour, texture, movement, and frame presence."
    paragraphs={[
      "Photoshoot hires are scoped around creative direction, practical wearability, and the type of movement or posing required.",
      "Looks can range from hero accessories to fuller costume styling depending on shoot goals and timelines."
    ]}
    chips={["Editorial looks", "Brand campaigns", "Creator content"]}
  />

  <SectionContainer tone="dark-band">
    <SectionTitle
      title="Content creation uses"
      subtitle="Brand, influencer, editorial, creative portfolio, and personal campaign shoots can all be scoped."
      class="section-intro [&_h2]:text-white [&_p]:text-white/70"
    />
  </SectionContainer>

  <SectionContainer spacing="footer-offset" id="photoshoot-enquiry">
    <ContactForm
      title="Photoshoot Costume Hire Enquiry"
      subtitle="Include shoot date, location, creative direction, costume colours, hire length, and styling needs."
      subject="Photoshoot Costume Hire Enquiry"
    />
  </SectionContainer>
</Layout>
