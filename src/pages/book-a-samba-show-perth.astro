---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Hero from "../components/Hero.astro";
import ContentEnquirySection from "../components/ContentEnquirySection.astro";
import { Picture } from "astro:assets";
import showForHireHero from "../images/showhero.avif";
import noBgDancer1 from "../images/noBgDancer1.avif";
import showsVideo from "../videos/shows-video.mp4";
import { localBusinessSchema, serviceSchema } from "../lib/schema";

const title = "Brazilian Samba Show Hire Perth | Samba Dancers for Events";
const description =
  "Book Brazilian samba dancers in Perth for weddings, corporate events, parties, festivals, and themed entertainment.";
const url = "/book-a-samba-show-perth";

const structuredData = [
  localBusinessSchema(),
  serviceSchema({
    name: "Brazilian samba show hire in Perth",
    description,
    url,
    image: showForHireHero.src,
  }),
];

const eventTypeCards = [
  { title: "Corporate Events", body: "Gala nights, launches, conferences, team celebrations, and client events.", href: "/corporate-entertainment-perth" },
  { title: "Gala Dinners & Award Nights", body: "Formal, black-tie, and awards programs timed to the run sheet.", href: "/gala-dinners-award-nights-perth" },
  { title: "Conferences & Launches", body: "Openers, product reveals, and high-energy conference moments.", href: "/conference-and-launch-entertainment-perth" },
  { title: "Client & Networking Events", body: "Roving performers for cocktail hours and relationship events.", href: "/client-networking-events-perth" },
  { title: "Weddings", body: "Reception entrances, feature performances, and cocktail hour roving.", href: "/wedding-entertainment-perth" },
  { title: "Hens Parties", body: "Workshop, show, and costume add-on options for private groups.", href: "/hens-party-perth" },
  { title: "Private Events", body: "Birthdays, anniversaries, engagements, and themed celebrations.", href: "/private-events-perth" },
  { title: "Festivals & Roving", body: "Festival programs, outdoor activations, and roving entertainment.", href: "/festival-entertainment-perth" },
];
---

<Layout
  title={title}
  description={description}
  image={showForHireHero.src}
  url={url}
  structuredData={structuredData}
  pageEvent="BookSambaShowView"
  hasHero={true}
>
  <Hero
    title="Brazilian Samba Entertainment for Corporate Events & Weddings in Perth"
    subtitle="High-impact samba shows, roving dancers, and optional live drumming — tailored to your venue, run sheet, and audience."
    backgroundImage={showForHireHero}
    primaryCta={{ label: "Request a Quote", href: "#show-enquiry" }}
    secondaryCta={{
      label: "Wedding & Corporate",
      href: "/wedding-corporate-event-entertainment-perth",
    }}
  />

  <SectionContainer spacing="hero-offset">
    <SectionTitle
      title="Samba entertainment for your run sheet"
      subtitle="Add a high-energy performance moment, roving visual impact, or interactive celebration to your event."
      class="section-intro"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 section-grid-wide items-center">
      <Picture
        src={noBgDancer1}
        alt="Brazilian samba dancer available for event entertainment in Perth"
        widths={[320, 480, 640, 800, 1200]}
        sizes="(max-width: 480px) 320px, (max-width: 768px) 480px, 800px"
        class="w-full h-full max-h-[720px] object-cover transition-transform duration-700 hover:scale-[1.02] image-overlay"
      />

      <div class="text-slate-600 text-lg leading-relaxed space-y-6">
        <p>
          Dance Bloc Brazil offers Brazilian samba show hire for weddings,
          corporate events, private parties, festivals, launches, and themed
          celebrations across Perth.
        </p>
        <p>
          Bookings can be shaped around your event: a feature performance,
          roving dancers, guest interaction, Carnival-style costumes, and
          optional live music or drumming where suitable.
        </p>
        <a
          href="#show-enquiry"
          class="inline-block px-8 py-3 bg-db-pink text-white font-bold rounded-lg hover:bg-db-light-pink transition-colors"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer wide class="px-0 sm:px-0 lg:px-0">
    <div
      class="reveal-on-scroll relative h-[100svh] w-full overflow-hidden bg-black"
    >
      <div class="absolute inset-0 overflow-hidden">
        <video
          class="absolute inset-0 hidden h-full w-full scale-110 object-cover blur-2xl brightness-75 lg:block"
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
          poster={showForHireHero.src}
        >
          <source src={showsVideo} type="video/mp4" />
        </video>
        <video
          class="absolute inset-0 h-full w-full object-cover object-center image-overlay lg:object-contain"
          autoplay
          muted
          loop
          playsinline
          poster={showForHireHero.src}
        >
          <source src={showsVideo} type="video/mp4" />
        </video>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer tone="tint">
    <SectionTitle
      title="Events we can offer entertainment for"
      subtitle="Use this page as the visual overview, then follow the event type that matches your booking."
      class="section-intro"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        eventTypeCards.map((card) => (
          <a
            href={card.href}
            class="motion-card reveal-on-scroll block rounded-xl border border-db-pink/80 bg-white p-6 shadow-md shadow-db-pink/5 transition hover:-translate-y-1"
            data-track="ShowEnquiryClick"
            data-track-params={JSON.stringify({ destination: card.href })}
          >
            <h3 class="text-xl font-bold mb-3 text-db-pink">{card.title}</h3>
            <p class="text-slate-600">{card.body}</p>
          </a>
        ))
      }
    </div>
  </SectionContainer>

  <ContentEnquirySection
    id="show-enquiry"
    title="Request a Quote"
    subtitle="Tell us about your event, date, venue, audience, and the kind of samba entertainment you have in mind."
    formTitle="Event Inquiry"
    formSubtitle="Share the date, venue, guest numbers, and whether you are interested in dancers only or dancers with live music/drumming."
    formSubject="Event Inquiry"
  />
</Layout>
