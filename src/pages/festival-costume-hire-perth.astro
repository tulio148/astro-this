---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import costumeHireHeroImage from "../images/costumeHireHeroAvif.avif";
import { serviceSchema } from "../lib/schema";

const title = "Festival Costume Hire Perth | Fringe, NYE & Themed Festival Outfits";
const description =
  "Festival costume hire in Perth for standout Carnival-inspired outfits, headpieces, cuffs, belts, and secure statement pieces.";
const url = "/festival-costume-hire-perth";
const structuredData = [
  serviceSchema({
    name: "Festival costume hire in Perth",
    description,
    url,
    image: costumeHireHeroImage.src,
  }),
];
---

<Layout
  title={title}
  description={description}
  image={costumeHireHeroImage.src}
  url={url}
  structuredData={structuredData}
>
  <TextHeroTop
    pageTitle="Festival Costume Hire in Perth"
    pageSubtitle="Standout Carnival-inspired pieces for Fringe, New Year's Eve, themed festivals, and high-colour events."
    valueTitle="Festival-appropriate pieces"
    valueSubtitle="The right hire pieces need to be secure, durable, and realistic for event conditions."
    paragraphs={[
      "Festival hires are selected for visual impact while accounting for movement, heat, and crowd environments.",
      "Options include accessories and selected full looks depending on your event format and practical requirements."
    ]}
    chips={["Festival-ready", "Durable wear", "High-colour impact"]}
  />

  <SectionContainer tone="dark-band">
    <SectionTitle
      title="Practical festival advice"
      subtitle="Security deposit, condition expectations, pickup and return timing, and what can safely be worn in crowds are confirmed before hire."
      class="section-intro [&_h2]:text-white [&_p]:text-white/70"
    />
  </SectionContainer>

  <SectionContainer spacing="footer-offset" id="festival-costume-enquiry">
    <ContactForm
      title="Festival Costume Hire Enquiry"
      subtitle="Include festival name, date, hire duration, costume style, and whether you need lighter accessory pieces or a full look."
      subject="Festival Costume Hire Enquiry"
    />
  </SectionContainer>
</Layout>
