---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import ComingSoonNotice from "../components/ComingSoonNotice.astro";
import cartoonDancerDouble from "../images/CartoonDancerDouble.avif";
import { organizationSchema } from "../lib/schema";

const title = "Our People | Dance Bloc Brazil Team & Performers";
const description =
  "Meet the team behind Dance Bloc Brazil - founder, lead performers, musicians, and collaborators who make every class, workshop, and event happen.";
const url = "/our-people";
---

<Layout title={title} description={description} image={cartoonDancerDouble.src} url={url} structuredData={[organizationSchema()]}>
    <TextHeroTop
    pageTitle="Our People"
    pageSubtitle="The team behind Dance Bloc Brazil's classes, performances, workshops, and events."
    valueTitle="Team and performers"
    valueSubtitle="Built around teaching quality, stage presence, and event professionalism."
    paragraphs={[
      "Dance Bloc Brazil works with performers and collaborators who bring strong movement standards and reliable delivery.",
      "Detailed profiles are being prepared so this page reflects active teaching, performance, and event teams accurately."
    ]}
    chips={["Teaching team", "Performance crew", "Collaborators"]}
  />

  <SectionContainer>
    <ComingSoonNotice
      title="Founder profile"
      message="The founder profile is coming soon with a real biography, teaching background, and current role in Dance Bloc Brazil's classes, performances, and events."
      items={[
        "Samba background",
        "Teaching approach",
        "Event direction",
        "Business story",
      ]}
    />
  </SectionContainer>

  <SectionContainer tone="tint">
    <ComingSoonNotice
      title="Team and performer profiles"
      message="Teacher, performer, musician, and collaborator profiles are being prepared. This area will stay clear until names, roles, photos, and bios are ready to publish."
      items={[
        "Lead performers",
        "Class teachers",
        "Workshop facilitators",
        "Creative collaborators",
      ]}
    />
  </SectionContainer>

  <SectionContainer><p class="max-w-4xl text-xl leading-relaxed text-slate-600">Dance Bloc Brazil works with a trusted network of musicians, photographers, stylists, and venue partners. These collaborations are selected for quality and consistency - not volume.</p></SectionContainer>

  <SectionContainer spacing="footer-offset" class="bg-slate-950 text-white">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <SectionTitle title="Work with us" subtitle="Dance Bloc Brazil occasionally works with new performers and musicians. Send an expression of interest if you have Brazilian samba performance experience." class="[&_h2]:text-white [&_p]:text-white/70" />
      <ContactForm title="Expression of Interest" subtitle="Tell us about your samba background, performance experience, and availability." subject="Expression of Interest - Performer" />
    </div>
  </SectionContainer>
</Layout>
