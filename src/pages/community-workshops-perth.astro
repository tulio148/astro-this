---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import danceclassHero from "../images/danceclassHero.avif";
import { serviceSchema } from "../lib/schema";

const title = "Community Samba Workshops Perth | Brazilian Dance for Groups & Events";
const description = "Inclusive Brazilian samba workshops for community groups, cultural programs, neighbourhood events, and not-for-profit organisations in Perth.";
const url = "/community-workshops-perth";
const structuredData = [serviceSchema({ name: "Community samba workshops in Perth", description, url, image: danceclassHero.src })];
---

<Layout title={title} description={description} image={danceclassHero.src} url={url} structuredData={structuredData}>
  <Hero title="Community Samba Workshops in Perth" subtitle="Open, inclusive Brazilian samba workshops for community groups, cultural programs, neighbourhood events, and not-for-profit organisations." backgroundImage={danceclassHero} primaryCta={{ label: "Enquire for Community", href: "#community-workshop-enquiry" }} />
  <SectionContainer spacing="hero-offset"><SectionTitle title="Built for community settings" subtitle="Accessible, warm, and inclusive - all bodies, all fitness levels, all backgrounds." class="section-intro" /><div class="grid grid-cols-1 gap-5 md:grid-cols-4">{["Community groups","Cultural centres","Women's groups","Multicultural programs"].map((item)=><div class="rounded-xl border border-db-pink/80 bg-white p-6 text-lg font-black text-db-pink">{item}</div>)}</div></SectionContainer>
  <SectionContainer class="bg-db-green/5"><SectionTitle title="What participants take away" subtitle="Joy, rhythm, connection, cultural immersion, and a shared movement experience." /></SectionContainer>
  <SectionContainer><SectionTitle title="Flexible format and pricing" subtitle="Community budgets differ from corporate budgets. Flexible arrangements for not-for-profit and community bookings can be discussed." /></SectionContainer>
  <SectionContainer class="bg-slate-950 text-white"><SectionTitle title="Cultural framing" subtitle="Brazilian samba is presented as a living cultural practice, not just entertainment." class="section-intro [&_h2]:text-white [&_p]:text-white/70" /></SectionContainer>
  <SectionContainer spacing="footer-offset" id="community-workshop-enquiry"><ContactForm title="Community Workshop Enquiry" subtitle="Tell us about your group, event context, suburb, preferred date, and budget range if relevant." subject="Community Workshop Enquiry" /></SectionContainer>
</Layout>
