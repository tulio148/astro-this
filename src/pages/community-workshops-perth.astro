---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import ContactForm from "../components/ContactForm.astro";
import danceclassHero from "../images/danceclassHero.avif";
import { serviceSchema } from "../lib/schema";

const title = "Community Samba Workshops Perth | Brazilian Dance for Groups & Events";
const description = "Inclusive Brazilian samba workshops for community groups, cultural programs, neighbourhood events, and not-for-profit organisations in Perth.";
const url = "/community-workshops-perth";
const structuredData = [serviceSchema({ name: "Community samba workshops in Perth", description, url, image: danceclassHero.src })];
---

<Layout title={title} description={description} image={danceclassHero.src} url={url} structuredData={structuredData}>
    <TextHeroTop
    pageTitle="Community Samba Workshops in Perth"
    pageSubtitle="Open, inclusive Brazilian samba workshops for community groups, cultural programs, neighbourhood events, and not-for-profit organisations."
    valueTitle="Built for community settings"
    valueSubtitle="Accessible, warm, and inclusive across ages, backgrounds, and confidence levels."
    paragraphs={[
      "Workshops are structured for participation and connection, with movement pathways that meet people where they are.",
      "Sessions can support community goals around cultural engagement, wellbeing, and shared experiences without performance pressure."
    ]}
    chips={["Inclusive format", "Cultural programs", "Community groups"]}
  />
  <SectionContainer tone="tint"><SectionTitle title="What participants take away" subtitle="Joy, rhythm, connection, cultural immersion, and a shared movement experience." /></SectionContainer>
  <SectionContainer><SectionTitle title="Flexible format and pricing" subtitle="Community budgets differ from corporate budgets. Flexible arrangements for not-for-profit and community bookings can be discussed." /></SectionContainer>
  <SectionContainer tone="dark-band"><SectionTitle title="Cultural framing" subtitle="Brazilian samba is presented as a living cultural practice, not just entertainment." class="section-intro [&_h2]:text-white [&_p]:text-white/70" /></SectionContainer>
  <SectionContainer spacing="footer-offset" id="community-workshop-enquiry"><ContactForm title="Community Workshop Enquiry" subtitle="Tell us about your group, event context, suburb, preferred date, and budget range if relevant." subject="Community Workshop Enquiry" /></SectionContainer>
</Layout>
