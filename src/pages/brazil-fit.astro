---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TextHeroTop from "../components/TextHeroTop.astro";
import FAQItem from "../components/FAQItem.astro";
import classesHero from "../images/classesHero.webp";
import { terms } from "../data/terms";
import { faqSchema, serviceSchema } from "../lib/schema";

const title = "Brazil Fit Perth | Brazilian Funk Dance Fitness Classes";
const description =
  "Brazil Fit is a high-energy Brazilian funk dance fitness class in Perth, inspired by baile funk, passinho footwork, hips, choreography, and club energy.";
const url = "/brazil-fit";
const brazilFitTerm = terms.find((term) => term.level === "Brazil Fit");
const bookingUrl =
  brazilFitTerm?.bookingLink ?? "/samba-classes-perth#class-times";
const classPrice = brazilFitTerm?.price ?? "";
const classLocation = brazilFitTerm?.location ?? "";
const features = [
  {
    title: "Brazilian funk energy",
    body: "Expect baile funk tracks, strong grooves, hips, attitude, and short choreography blocks that keep the room moving.",
  },
  {
    title: "Footwork, hips, and coordination",
    body: "Brazilian funk draws from passinho-style steps, street dance, samba, capoeira, frevo, and breaking, so your whole body stays switched on.",
  },
  {
    title: "No partner, no performance pressure",
    body: "You are learning fun routines in a room full of people moving for fitness, confidence, and release.",
  },
  {
    title: "High energy, scalable intensity",
    body: "Push the cardio when you want it. Take lower-impact options when you need them. The class stays accessible.",
  },
];
const benefits = [
  {
    benefit: "Cardiovascular fitness",
    detail:
      "Fast combinations, repeated grooves, and continuous movement keep the heart rate elevated.",
  },
  {
    benefit: "Hip mobility",
    detail:
      "Brazilian funk uses hip-driven movement, body rolls, drops, and isolations that build control and range.",
  },
  {
    benefit: "Core activation",
    detail:
      "Changing levels, holding posture, and moving hips and feet together keeps the core active.",
  },
  {
    benefit: "Coordination",
    detail:
      "Footwork, arms, hips, and musical accents train coordination without feeling like a drill.",
  },
  {
    benefit: "Lower-body strength",
    detail:
      "Squats, drops, pulses, and directional changes challenge legs and glutes in a dance context.",
  },
  {
    benefit: "Mood",
    detail:
      "Baile funk energy, group movement, and loud music make the class feel more like a release than a workout.",
  },
];
const faqs = [
  {
    question: "Is Brazil Fit the same as Zumba?",
    answer:
      "No. Brazil Fit is focused on Brazilian funk dance, including baile funk energy, passinho-inspired footwork, hips, isolations, and choreography. It is more specific than a general Latin fitness class.",
  },
  {
    question: "What should I wear?",
    answer:
      "Comfortable workout clothes and sneakers with non-marking soles. Bring water. Nothing else required.",
  },
  {
    question: "Can I do Brazil Fit if I have never done Brazilian funk?",
    answer:
      "Yes. The class is designed for first-timers as well as people who already love Brazilian funk music and movement.",
  },
  {
    question: "Is it intense?",
    answer:
      "Yes - it is a genuine cardio class. Modifications are always available but the default energy is high.",
  },
  {
    question: "Can I do both Brazil Fit and samba technique classes?",
    answer:
      "Yes. They complement each other well - Brazil Fit builds stamina, confidence, and choreography pick-up; samba technique classes build samba no pe skill.",
  },
];
const structuredData = [
  serviceSchema({
    name: "Brazil Fit Brazilian funk dance fitness classes in Perth",
    description,
    url,
    image: classesHero.src,
  }),
  faqSchema(faqs),
];
---

<Layout
  title={title}
  description={description}
  image={classesHero.src}
  url={url}
  structuredData={structuredData}
>
    <TextHeroTop
    pageTitle="Brazil Fit"
    pageSubtitle="Brazilian funk dance fitness. Baile funk energy, choreography, hips, footwork, and sweat."
    valueTitle="A workout that moves like a Brazilian funk party."
    valueSubtitle="Built around music, choreography, and release - no exams, no partners."
    paragraphs={[
      "Expect baile funk tracks, strong grooves, hips, attitude, and short choreography blocks that keep the room moving.",
      "Brazil Fit is high-energy but scalable, with lower-impact options available while keeping the class engaging and cardio-focused."
    ]}
    chips={["Baile funk energy", "Beginner-friendly choreography", "High-cardio movement"]}
  />
  <SectionContainer tone="dark-band">
    <SectionTitle
      title="What Brazil Fit actually does to your body"
      class="section-intro [&_h2]:text-white"
    />
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {benefits.map((item) => (
        <div class="rounded-xl border border-white/12 bg-white/5 p-6">
          <h3 class="text-xl font-black text-db-green">{item.benefit}</h3>
          <p class="mt-3 text-white/75">{item.detail}</p>
        </div>
      ))}
    </div>
  </SectionContainer>

  <SectionContainer tone="tint">
    <p class="max-w-3xl text-xl leading-relaxed text-slate-600">
      People who are bored of the gym. People who love Brazilian funk and want
      to move to it properly. People who danced years ago and want to come back
      without committing to technique classes. People who want cardio with more
      personality than a treadmill. People who need 60 minutes of loud
      Brazilian music, choreography, confidence, and sweat once a week.
    </p>
  </SectionContainer>

  <SectionContainer>
    <SectionTitle
      title="Schedule"
      subtitle="Brazil Fit classes run as part of the Dance Bloc Brazil term schedule."
      class="section-intro"
    />
    <p class="max-w-3xl text-lg text-slate-600">
      Brazil Fit sessions are listed alongside samba no pe classes. Check the
      current term for available times. Current terms include {terms.length}
      booking options.
    </p>
    <a
      href="/samba-classes-perth#schedule"
      class="mt-6 inline-flex rounded-full bg-db-green px-7 py-3 text-sm font-black uppercase tracking-[0.14em] text-white hover:bg-db-pink"
      data-track="BookClassClick"
    >
      See the Class Schedule
    </a>
  </SectionContainer>

  <SectionContainer>
    <SectionTitle title="Brazil Fit FAQs" class="section-intro" />
    <div class="mx-auto max-w-5xl">
      {faqs.map((faq) => (
        <FAQItem question={faq.question} answer={faq.answer} />
      ))}
    </div>
  </SectionContainer>

  <SectionContainer spacing="footer-offset" class="bg-db-green text-white">
    <SectionTitle
      title="Ready to move?"
      subtitle="Book your Brazil Fit class directly, or check all class options."
      class="section-intro [&_h2]:text-white [&_p]:text-white/85"
    />
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full bg-white px-7 py-3 text-sm font-black uppercase tracking-[0.14em] text-db-pink hover:bg-db-pink hover:text-white"
        data-track="BookClassClick"
        data-track-params={JSON.stringify({
          class_name: "Brazil Fit",
          class_level: "Brazil Fit",
          class_price: classPrice,
          class_location: classLocation,
        })}
      >
        Book Now
      </a>
      <a
        href="/samba-classes-perth#class-times"
        class="inline-flex rounded-full border border-white/80 bg-transparent px-7 py-3 text-sm font-black uppercase tracking-[0.14em] text-white hover:bg-white hover:text-db-pink"
      >
        See All Class Times
      </a>
    </div>
  </SectionContainer>
</Layout>
