---
interface Props {
  items: string[];
  class?: string;
}

const { items = [], class: className = "" } = Astro.props;
---

<div class:list={["grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4", className]}>
  {
    items.map((item) => (
      <div class="rounded-full border border-db-green/40 bg-white px-5 py-3 text-center font-black text-db-pink">
        {item}
      </div>
    ))
  }
</div>
