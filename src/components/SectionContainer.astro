---
interface Props {
  class?: string;
  id?: string;
  wide?: boolean;
}

const { class: className = "", id, wide = false } = Astro.props;
const widthClass = wide ? "max-w-none" : "max-w-7xl";
---

<section
  id={id}
  class={`section-container reveal-section py-14 md:py-20 px-6 sm:px-10 lg:px-16 mx-auto ${className}`}
>
  <div class={`${widthClass} mx-auto`}>
    <slot />
  </div>
</section>
