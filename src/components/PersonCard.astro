---
import type { Person } from "../data/people";
import cartoonDancerDouble from "../images/cartoonDancerDouble.avif";

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<div class="reveal-on-scroll motion-card group overflow-hidden rounded-xl border border-db-pink/80 bg-white shadow-[0_18px_48px_rgba(158,0,150,0.09)]">
  <div class="aspect-[4/5] overflow-hidden bg-db-light-pink/10">
    {
      person.image ? (
        <img
          src={person.image.src}
          alt={person.name}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-db-light-pink/20 to-db-green/10">
          <img
            src={cartoonDancerDouble.src}
            alt=""
            class="h-3/4 w-3/4 object-contain opacity-40"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
  <div class="p-6">
    <p class="mb-1 text-xs font-black uppercase tracking-[0.18em] text-db-green">
      {person.role}
    </p>
    <h3 class="text-2xl font-black text-db-pink">{person.name}</h3>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        person.specialty.map((specialty) => (
          <span class="rounded-full border border-db-pink/30 bg-db-light-pink/8 px-2.5 py-1 text-[11px] font-bold text-db-pink">
            {specialty}
          </span>
        ))
      }
    </div>
    <p class="mt-4 text-base leading-relaxed text-slate-600">{person.bio}</p>
  </div>
</div>
