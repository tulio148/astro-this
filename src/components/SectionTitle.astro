---
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
  align?: "left" | "center";
}

const { title, subtitle, class: className, align = "left" } = Astro.props;
const alignment =
  align === "center"
    ? "mx-auto text-center items-center"
    : "text-left items-start";
---

<div
  class:list={[
    "section-title flex max-w-5xl flex-col gap-4",
    alignment,
    className,
  ]}
>
  <p class="text-xs font-bold uppercase tracking-[0.28em] text-db-green">
    Dance Bloc Brazil
  </p>
  <h2
    class="relative py-2 text-5xl md:text-7xl font-black leading-[0.92] text-db-pink drop-shadow-[0_10px_18px_rgba(158,0,150,0.16)] text-balance"
  >
    {title}
    <span
      class="absolute bottom-0 left-0 h-[2px] w-1/3 rounded-full bg-gradient-to-r from-db-green to-transparent"
    ></span>
  </h2>
  {
    subtitle && (
      <p class="max-w-5xl text-lg md:text-xl leading-relaxed text-slate-700 text-balance tracking-wide">
        {subtitle}
      </p>
    )
  }
</div>
