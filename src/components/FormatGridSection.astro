---
import SectionTitle from "./SectionTitle.astro";

interface Item {
  label?: string;
  title: string;
  body: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: Item[];
  tone?: "light" | "dark-band";
  columns?: 2 | 3 | 4;
  class?: string;
}

const {
  title,
  subtitle,
  items = [],
  tone = "light",
  columns = 3,
  class: className = "",
} = Astro.props;

const colsClass =
  columns === 4
    ? "md:grid-cols-2 lg:grid-cols-4"
    : columns === 2
      ? "md:grid-cols-2"
      : "md:grid-cols-2 lg:grid-cols-3";
const cardClass =
  tone === "dark-band"
    ? "rounded-xl border border-white/12 bg-white/5 p-7"
    : "rounded-xl border border-db-pink/80 bg-white p-7 shadow-[0_18px_44px_rgba(158,0,150,0.09)]";
const headingClass = tone === "dark-band" ? "text-white" : "text-db-pink";
const bodyClass = tone === "dark-band" ? "text-white/78" : "text-slate-600";
const sectionTitleClass =
  tone === "dark-band"
    ? "section-intro [&_h2]:text-white [&_p]:text-white/70"
    : "section-intro";
---

<div class:list={["format-grid-section", className]}>
  <SectionTitle
    title={title}
    subtitle={subtitle}
    class={sectionTitleClass}
  />
  <div class:list={["grid grid-cols-1 gap-5", colsClass]}>
    {
      items.map((item, index) => (
        <div class={`motion-card reveal-on-scroll ${cardClass}`} style={`--card-lift-delay: ${index * 220}ms`}>
          {item.label && (
            <p class="text-xs font-black uppercase tracking-[0.18em] text-db-green">
              {item.label}
            </p>
          )}
          <h3 class:list={["mt-3 text-2xl font-black", headingClass]}>{item.title}</h3>
          <p class:list={["mt-4 text-base leading-relaxed", bodyClass]}>{item.body}</p>
        </div>
      ))
    }
  </div>
</div>
